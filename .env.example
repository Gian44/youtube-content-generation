# ============================================
# StoryFactory Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# --- Database ---
# PostgreSQL connection URL (cloud mode)
# DATABASE_URL=postgresql://user:password@host:5432/storyfactory
# SQLite path (local-only mode, used if DATABASE_URL is not set)
SQLITE_PATH=./data/storyfactory.db

# --- Secret Encryption (app-level master key) ---
# Encrypts per-channel API keys / OAuth tokens stored in the database.
# Generate one with: python -m storyfactory channel generate-key
# If left blank, a key is generated and written to STORYFACTORY_KEY_FILE on first use.
STORYFACTORY_SECRET_KEY=
# STORYFACTORY_KEY_FILE=./.storyfactory.key

# --- Default Channel (used when migrating an existing single-channel install) ---
CHANNEL_SLUG=default
CHANNEL_NAME=Main Channel

# --- AI Providers (SHARED; configure once under Settings → Integrations) ---
# These values SEED the app-level integrations on first run and act as a runtime
# fallback. After setup, the values stored via the dashboard/CLI are authoritative
# (a later edit here never overwrites a key you set in the UI). Shared across all
# channels — do NOT set these per channel.
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- YouTube OAuth (shared client app; the refresh token is PER CHANNEL) ---
# CLIENT_ID/SECRET/REDIRECT are the one shared Google Cloud OAuth app. Each
# channel connects its own account; its refresh token is stored encrypted per
# channel. The value below only seeds the default channel.
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=

# --- Asset Providers (SHARED; Settings → Integrations) ---
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key
# Jamendo: free Creative Commons MUSIC for recap "original_audio" mode
# (Pixabay has no music API). Register a free app at https://devportal.jamendo.com
# to get a client_id. Leave as the placeholder to disable the music bed.
JAMENDO_CLIENT_ID=your-jamendo-client-id

# --- Storage ---
# Options: local, r2
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./data/storage

# Cloudflare R2 (if STORAGE_MODE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=storyfactory
R2_PUBLIC_BASE_URL=

# --- Automation ---
AUTO_MODE=true
REQUIRE_APPROVAL=false
UPLOAD_PRIVACY_MODE=public
ALLOW_PRIVATE_FALLBACK=true

# --- Pipeline mode (per-channel; this is only the app-level default) ---
# Each channel's content engine: fiction (default Reddit-style drama),
# recap_shorts (CinybeShorts: many Shorts from local video files), or
# sleep_facts (Sleep On Facts: one calm single-topic long-form video).
# Set per channel in the dashboard (Channels) — the value below is just the default.
# See docs/multi-channel.md and docs/setup-external-tools.md.
PIPELINE_MODE=fiction

# --- Content Quotas & Outputs (per-channel overrides live in the DB) ---
SHORTS_PER_DAY_MIN=3
SHORTS_PER_DAY_MAX=5
LONG_FORM_PER_DAY=1
LONG_FORM_TARGET_MINUTES=10
# Which outputs a channel produces by default — each channel can override these
# in the dashboard (Channels → Content). At least one must be true.
#   ENABLE_SHORTS=true,  ENABLE_LONG_FORM=false → shorts-only channel
#   ENABLE_SHORTS=false, ENABLE_LONG_FORM=true  → long-form-only (e.g. sleep facts)
ENABLE_SHORTS=true
ENABLE_LONG_FORM=true
# Number of long-form stories composed into one long-form video (was hardcoded).
LONG_FORM_SEGMENTS_MIN=2
LONG_FORM_SEGMENTS_MAX=5
# Whether approved Shorts are also folded into the long-form compilation.
LONG_FORM_INCLUDES_SHORTS=true

# --- Topic Selection ---
DAILY_TOPIC_MODE=weighted_random

# --- TTS Provider Ratio ---
# Ratio of TTS requests sent to each provider (must sum to 1.0)
TTS_OPENAI_RATIO=0.8
TTS_GEMINI_RATIO=0.2

# --- Safety ---
FAIL_SAFE_ON_POLICY_FLAG=true
FAIL_SAFE_ON_LICENSE_UNKNOWN=true

# --- Dashboard ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Worker ---
WORKER_PORT=8787
WORKER_LOG_LEVEL=INFO

# --- Dry Run ---
# Set to true to test the full pipeline without uploading to YouTube or spending API credits
DRY_RUN=false
