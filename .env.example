# ============================================
# StoryFactory Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# --- Database ---
# PostgreSQL connection URL (cloud mode)
# DATABASE_URL=postgresql://user:password@host:5432/storyfactory
# SQLite path (local-only mode, used if DATABASE_URL is not set)
SQLITE_PATH=./data/storyfactory.db

# --- Secret Encryption (app-level master key) ---
# Encrypts per-channel API keys / OAuth tokens stored in the database.
# Generate one with: python -m storyfactory channel generate-key
# If left blank, a key is generated and written to STORYFACTORY_KEY_FILE on first use.
STORYFACTORY_SECRET_KEY=
# STORYFACTORY_KEY_FILE=./.storyfactory.key

# --- Default Channel (used when migrating an existing single-channel install) ---
CHANNEL_SLUG=default
CHANNEL_NAME=Main Channel

# --- AI Providers (app-level defaults; per-channel overrides live in the DB) ---
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- YouTube OAuth ---
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=

# --- Asset Providers ---
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# --- Storage ---
# Options: local, r2
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./data/storage

# Cloudflare R2 (if STORAGE_MODE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=storyfactory
R2_PUBLIC_BASE_URL=

# --- Automation ---
AUTO_MODE=true
REQUIRE_APPROVAL=false
UPLOAD_PRIVACY_MODE=public
ALLOW_PRIVATE_FALLBACK=true

# --- Content Quotas ---
SHORTS_PER_DAY_MIN=3
SHORTS_PER_DAY_MAX=5
LONG_FORM_PER_DAY=1
LONG_FORM_TARGET_MINUTES=10

# --- Topic Selection ---
DAILY_TOPIC_MODE=weighted_random

# --- TTS Provider Ratio ---
# Ratio of TTS requests sent to each provider (must sum to 1.0)
TTS_OPENAI_RATIO=0.8
TTS_GEMINI_RATIO=0.2

# --- Safety ---
FAIL_SAFE_ON_POLICY_FLAG=true
FAIL_SAFE_ON_LICENSE_UNKNOWN=true

# --- Dashboard ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Worker ---
WORKER_PORT=8787
WORKER_LOG_LEVEL=INFO

# --- Dry Run ---
# Set to true to test the full pipeline without uploading to YouTube or spending API credits
DRY_RUN=false
